<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LightCrm.Views.ContactDialog"
        Title="Контакт" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="6">
    <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBlock Text="Ім'я *" />
    <TextBox Text="{Binding Name}" />
    <TextBlock Text="Компанія *" />
    <TextBox Text="{Binding Company}" />
    <TextBlock Text="Телефон * (напр. +380501234567)" />
    <TextBox Text="{Binding Phone}" />
    <TextBlock Text="E-mail * (напр. name@company.ua)" />
    <TextBox Text="{Binding Email}" />
    <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Зберегти" IsDefault="True" Click="OnOk" />
      <Button Content="Скасувати" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
