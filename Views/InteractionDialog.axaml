<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LightCrm.Views.InteractionDialog"
        Title="Взаємодія" Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="6">
    <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />

    <TextBlock Text="Тип *" />
    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}"
              SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
              IsEnabled="{Binding IsKindEditable}">
      <ComboBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <StackPanel Orientation="Horizontal" Spacing="12">
      <StackPanel Spacing="6">
        <TextBlock Text="Дата *" />
        <CalendarDatePicker SelectedDate="{Binding DateValue, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Text="Час (ГГ:хх) *" />
        <TextBox Width="90" Text="{Binding TimeText}" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="Опис *" />
    <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />

    <!-- Дзвінок -->
    <StackPanel IsVisible="{Binding IsCall}" Spacing="6">
      <TextBlock Text="Тривалість, хв" />
      <TextBox Text="{Binding DurationText}" />
      <TextBlock Text="Телефон (необов'язково)" />
      <TextBox Text="{Binding Phone}" />
    </StackPanel>

    <!-- Зустріч -->
    <StackPanel IsVisible="{Binding IsMeeting}" Spacing="6">
      <TextBlock Text="Місце *" />
      <TextBox Text="{Binding Location}" />
    </StackPanel>

    <!-- Лист -->
    <StackPanel IsVisible="{Binding IsEmail}" Spacing="6">
      <TextBlock Text="Тема *" />
      <TextBox Text="{Binding Subject}" />
      <CheckBox Content="Вхідний лист" IsChecked="{Binding IsIncoming, Mode=TwoWay}" />
    </StackPanel>

    <!-- Для Call і Meeting (IScheduledAction) -->
    <CheckBox Content="Виконано" IsVisible="{Binding IsScheduled}"
              IsChecked="{Binding IsCompleted, Mode=TwoWay}" />

    <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Зберегти" IsDefault="True" Click="OnOk" />
      <Button Content="Скасувати" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
