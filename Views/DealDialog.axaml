<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LightCrm.Views.DealDialog"
        Title="Угода" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="6">
    <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBlock Text="Контакт *" />
    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Contacts}"
              SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
              IsEnabled="{Binding IsContactEditable}">
      <ComboBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="Назва угоди *" />
    <TextBox Text="{Binding Title}" />
    <TextBlock Text="Сума * (більша за 0)" />
    <TextBox Text="{Binding AmountText}" />
    <TextBlock Text="Етап *" />
    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StageOptions}"
              SelectedItem="{Binding SelectedStage, Mode=TwoWay}">
      <ComboBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="Дата *" />
    <CalendarDatePicker SelectedDate="{Binding DateValue, Mode=TwoWay}" />
    <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Зберегти" IsDefault="True" Click="OnOk" />
      <Button Content="Скасувати" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
